# Copy to .env for local development. Production sets these in its host's settings.

# The database the app reads and writes. Migrations are applied to it at startup.
DATABASE_URL=postgres://crossline:crossline@127.0.0.1:5441/crossline

# A database on the same server that tests may connect to in order to create and drop
# their own throwaway databases. Tests never touch DATABASE_URL.
TEST_DATABASE_URL=postgres://crossline:crossline@127.0.0.1:5441/postgres

# The address people reach the app at, with no trailing slash.
PUBLIC_URL=https://go-crossline.argo.gibsonops.com

PORT=44100
