{
  "name": "crossline",
  "private": true,
  "type": "module",
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "css": "tailwindcss -i styles/app.css -o public/app.css --minify",
    "css:watch": "tailwindcss -i styles/app.css -o public/app.css --watch",
    "build": "npm run css",
    "dev": "npm run css && NODE_ENV=development node --env-file-if-exists=.env --watch --import remix/node-tsx server.ts",
    "hmr": "npm run css && NODE_ENV=development node --env-file-if-exists=.env hmr.ts",
    "start": "NODE_ENV=production node --env-file-if-exists=.env --import remix/node-tsx server.ts",
    "test": "NODE_ENV=test remix test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "doctor": "remix doctor",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "engines": {
    "node": ">=24.3.0"
  },
  "dependencies": {
    "effect": "4.1.2",
    "pg": "8.23.1",
    "remix": "3.2.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.5",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "daisyui": "5.7.50",
    "oxlint": "1.92.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2"
  }
}
